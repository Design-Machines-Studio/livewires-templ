package component

import lw "github.com/Design-Machines-Studio/livewires-templ"

// LoaderPanelProps configures Driver Line centered within a container.
type LoaderPanelProps struct {
	Label string // Accessible status, visually hidden; defaults to Loading
	Mixed bool
	Class string
	Attrs templ.Attributes // Host-owned visibility and stable IDs; reserve class and ARIA
}

// LoaderPanelComponent renders only centered Driver Line visibly.
templ LoaderPanelComponent(props LoaderPanelProps) {
	<div class={ lw.ClassNames("loader-panel", props.Class) } role="status" aria-atomic="true" { props.Attrs... }>
		@LoaderIconComponent(LoaderIconProps{Variant: "line", Mixed: props.Mixed})
		<span class="visually-hidden">{ hardwareLoaderLabel(props.Label) }</span>
	</div>
}

// LoaderPanel renders a centered container loader.
templ LoaderPanel(label string) {
	@LoaderPanelComponent(LoaderPanelProps{Label: label})
}

// LoaderOverlayProps configures a viewport overlay with an 80% background.
type LoaderOverlayProps struct {
	Label string // Accessible status, visually hidden; defaults to Loading
	Mixed bool
	Class string
	Attrs templ.Attributes // Host-owned visibility and stable IDs; reserve class and ARIA
}

// LoaderOverlayComponent renders only Driver Line centered over the viewport.
// The application owns visibility, busy/inert content and request lifecycle.
templ LoaderOverlayComponent(props LoaderOverlayProps) {
	<div class={ lw.ClassNames("loader-overlay", props.Class) } role="status" aria-atomic="true" { props.Attrs... }>
		@LoaderIconComponent(LoaderIconProps{Variant: "line", Mixed: props.Mixed})
		<span class="visually-hidden">{ hardwareLoaderLabel(props.Label) }</span>
	</div>
}

// LoaderOverlay renders a page loader; hide it through Attrs when initially idle.
templ LoaderOverlay(label string) {
	@LoaderOverlayComponent(LoaderOverlayProps{Label: label})
}
