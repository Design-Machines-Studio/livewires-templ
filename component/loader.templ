package component

import lw "github.com/Design-Machines-Studio/livewires-templ"

// LoaderProps holds configuration for a loader component.
type LoaderProps struct {
	Label   string           // Accessible label for screen readers (e.g., "Loading members")
	Variant string           // CSS modifier for loading animation style
	Class   string           // Additional CSS classes from consumer
	Attrs   templ.Attributes // Catch-all: data-*, aria-*, etc.
}

// LoaderComponent renders a loading indicator with full Props control.
templ LoaderComponent(props LoaderProps) {
	<div
		class={ lw.ClassNames("loading", lw.VariantClass("loading", props.Variant), props.Class) }
		role="status"
		if props.Label != "" {
			aria-label={ props.Label }
		}
		{ props.Attrs... }
	>
		<div class="skeleton skeleton--text"></div>
		<div class="skeleton skeleton--text"></div>
	</div>
}

// Loader renders a loading indicator (convenience wrapper).
templ Loader(label string, variant string) {
	@LoaderComponent(LoaderProps{Label: label, Variant: variant})
}

// LoadingRegionProps configures a local loading operation's stable ownership boundary.
type LoadingRegionProps struct {
	ID    string           // Stable ID for the operation root
	Label string           // Accessible name for this operation region
	Class string           // Additional CSS classes from consumer
	Attrs templ.Attributes // Developer-controlled data-*, aria-* and Datastar attributes
}

// LoadingRegionComponent keeps the busy content separate from its announcement.
// Children are operation-local content. The optional controller owns the data hooks.
templ LoadingRegionComponent(props LoadingRegionProps) {
	<section
		data-loading-region
		if props.ID != "" {
			id={ props.ID }
		}
		if props.Label != "" {
			aria-label={ props.Label }
		}
		if props.Class != "" {
			class={ lw.ClassNames(props.Class) }
		}
		{ props.Attrs... }
	>
		<div data-loading-content aria-busy="false">
			{ children... }
			<div class="loading" data-loading-indicator hidden aria-hidden="true">
				<div class="skeleton skeleton--text"></div>
				<div class="skeleton skeleton--text"></div>
			</div>
		</div>
		<p data-loading-status role="status" aria-live="polite" aria-atomic="true"></p>
	</section>
}

// LoadingRegion wraps operation content with native fallback hooks for optional loading behavior.
templ LoadingRegion(label string) {
	@LoadingRegionComponent(LoadingRegionProps{Label: label}) {
		{ children... }
	}
}
