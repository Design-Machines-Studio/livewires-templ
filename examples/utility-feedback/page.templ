package utilityfeedback

import "github.com/Design-Machines-Studio/livewires-templ/component"

const relativeTimeAsset = "https://raw.githubusercontent.com/Design-Machines-Studio/livewires/f73b8a26d9c449ede4069edfe13eb50c2876a732/public/dist/relative-time.js"
const copyAsset = "https://raw.githubusercontent.com/Design-Machines-Studio/livewires/f73b8a26d9c449ede4069edfe13eb50c2876a732/public/dist/copy-button.js"
const loadingAsset = "https://raw.githubusercontent.com/Design-Machines-Studio/livewires/98b890dc804813b0b36b9a484bf49e3bdc7f196b/public/dist/loading.js"
const toastAsset = "https://raw.githubusercontent.com/Design-Machines-Studio/livewires/6e0ff82c222c644fdda687a46bcd24816b7f7dc1/public/dist/toast-region.js"
const liveWiresCSS = "https://raw.githubusercontent.com/Design-Machines-Studio/livewires/6e0ff82c222c644fdda687a46bcd24816b7f7dc1/public/dist/main.css"

templ Page() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Live Wires interaction utility example</title>
			<link rel="stylesheet" href={ liveWiresCSS }/>
			<script type="module" src={ relativeTimeAsset }></script>
			<script type="module" src={ copyAsset }></script>
			<script type="module" src={ loadingAsset }></script>
			<script type="module" src={ toastAsset }></script>
		</head>
		<body>
			<main id="main">
				<h1>Interaction utility hooks</h1>
				<p>Updated</p>
				@Example("relative-time")
				@Example("copy")
				@Example("loading")
				@component.ToastRegionComponent(component.ToastRegionProps{Label: "Editor feedback"}) {
					@component.ToastComponent(component.ToastProps{ID: "save-42:confirmed", Message: "Your changes were saved.", Variant: "success", Dismissible: true, DismissLabel: "Dismiss saved message", Managed: true})
				}
			</main>
		</body>
	</html>
}
