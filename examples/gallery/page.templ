package main

import "strings"
import "github.com/Design-Machines-Studio/livewires-templ/component"
import utility "github.com/Design-Machines-Studio/livewires-templ/examples/utility-feedback"
import "github.com/Design-Machines-Studio/livewires-templ/form"

templ page(name string, source sourceIdentity, order []string, message string, variant string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			if name=="" {
				<title>Live Wires component gallery</title>
			} else {
				<title>{ "Live Wires gallery · " + name }</title>
			}
			<link rel="icon" href="data:,"/>
			<link rel="stylesheet" href="/assets/main.css"/>
			if name=="sortable" {
				<link rel="stylesheet" href="/assets/sortable-list.css"/>
			}
			if name=="inline-edit" {
				<link rel="stylesheet" href="/assets/inline-edit.css"/>
			}
			if name=="combobox" {
				<link rel="stylesheet" href="/assets/combobox.css"/>
			}
			if name=="save-status" {
				<link rel="stylesheet" href="/assets/save-status.css"/>
			}
			if name!="" {
				<script type="module" src="/demo.js"></script>
			}
		</head>
		<body class="scheme-default" data-example={ name }>
			<a href="#main" class="skip-link">Skip to content</a>
			if name!="" {
				<nav class="center" aria-label="Gallery"><a href="/">Component gallery</a></nav>
			}
			<main class="section center stack" id="main">
				if name=="" {
					<h1>Component gallery</h1>
					<p>Generated Templ components from this checkout, with pinned Live Wires assets.</p>
					<ul>
						for _, example := range examples {
							<li><a href={ templ.URL("/examples/" + example) }>{ example }</a></li>
						}
					</ul>
				} else {
					if name != "page-header" {
						<h1>{ name }</h1>
					}
					<p>Local demonstration. Outcomes are simulated; nothing is saved. Reload the example URL to reset.</p>
					switch name {
						case "relative-time", "copy", "loading", "toast":
							if name=="toast" && message!="" {
								@component.ToastRegionComponent(component.ToastRegionProps{Label: "Editor feedback"}) {
									@component.ToastComponent(component.ToastProps{ID: "demo:result", Message: message, Variant: variant, Dismissible: true, Managed: true})
								}
							} else {
								@utility.Example(name)
							}
						case "sortable":
							@sortableExample(order)
						case "inline-edit":
							@inlineExample()
						case "combobox":
							@comboboxExample()
						case "save-status":
							@saveStatusExample()
						case "page-header":
							@pageHeaderExample()
					}
					if name=="loading" || name=="toast" || name=="sortable" || name=="inline-edit" {
						<form method="get" action={ templ.URL("/examples/" + name) } id="scenario-form" hidden?={ name=="sortable" || name=="inline-edit" }>
							<label for="scenario">Response scenario</label>
							<select id="scenario" name="scenario">
								<option value="normal">Normal</option><option value="delayed">Delayed</option><option value="failure">Failure</option><option value="unknown">Unknown result</option>
							</select>
							if name=="loading" || name=="toast" {
								<button name="run" value="1" type="submit">Run scenario</button>
							} else {
								<p>Use the component controls to try the selected response.</p>
							}
						</form>
						<button id="unrelated" type="button" hidden>Update unrelated note</button>
						<p id="unrelated-note">Unrelated note stays available.</p>
						<label for="unrelated-input">Unrelated input</label><input id="unrelated-input" value="Keep editing"/>
						<a href={ templ.URL("/examples/" + name) }>Reload and recover</a>
					}
					if name=="loading" || name=="toast" || name=="sortable" || name=="inline-edit" || name=="combobox" {
						<p id="demo-outcome" role="status">{ message }</p>
					}
					<noscript>
						<p>Native controls and visible content remain available.</p>
						if name=="loading" || name=="toast" {
							<p>Choose a scenario and submit to see its simulated outcome.</p>
						}
					</noscript>
				}
				<footer class="stack text-sm" id="source-build" data-source-head={ source.Commit } data-source-fingerprint={ source.Fingerprint } data-source-dirty={ source.Dirty }>
					<p>Source: <code>{ source.Commit }</code>. Branch: { source.Branch }.</p>
					if source.Dirty {
						<p>Dirty build: the fingerprint identifies these uncommitted bytes.</p>
					} else {
						<p>Clean checkout build.</p>
					}
					<details><summary>Build provenance</summary><p>Checkout: { source.Checkout }</p><p>Fingerprint: { source.Fingerprint }</p><p>Live Wires: { source.AssetRevision }</p></details>
				</footer>
			</main>
		</body>
	</html>
}

templ pageHeaderActions() {
	<a href="#header-action-result" class="button" data-example-action>Review members</a>
}

templ pageHeaderSupplement() {
	<p class="text-sm">Supplementary content remains owned by the consuming page.</p>
}

templ pageHeaderExample() {
	<section aria-labelledby="title-only-heading">
		@component.PageHeaderComponent(component.PageHeaderProps{
			Title: "Title-only header",
			Class: "section section-snug",
			HeadingAttrs: templ.Attributes{"id": "title-only-heading"},
		})
	</section>
	<section aria-labelledby="lead-heading">
		@component.PageHeaderComponent(component.PageHeaderProps{
			Title: "A header with a lead",
			Lead: "Use the lead for a short introduction that gives people useful context before they reach the page content.",
			Class: "section section-snug",
			HeadingAttrs: templ.Attributes{"id": "lead-heading"},
		})
	</section>
	<section aria-labelledby="actions-heading">
		@component.PageHeaderComponent(component.PageHeaderProps{
			Title: "Member directory",
			Class: "section section-snug",
			HeadingAttrs: templ.Attributes{"id": "actions-heading"},
			LayoutClass: "cluster cluster-between items-end",
			ContentClass: "prose",
			Actions: pageHeaderActions(),
		})
	</section>
	<section aria-labelledby="long-heading">
		@component.PageHeaderComponent(component.PageHeaderProps{
			Title: "Review the shared decisions and records for your cooperative before making changes",
			Lead: "This longer title shows how headings and supporting content reflow at narrower widths.",
			Class: "section section-snug",
			HeadingAttrs: templ.Attributes{"id": "long-heading"},
			Supplement: pageHeaderSupplement(),
		})
	</section>
	<p id="header-action-result">The action link keeps its normal keyboard behavior.</p>
}

templ saveStatusExample() {
	<div class="stack" data-save-scheme>
		<div data-save-controls hidden>
		<section class="stack" aria-labelledby="scheme-heading">
			<h2 id="scheme-heading">Color scheme</h2>
			<p>Inherited follows the browser’s color scheme. Light and dark set a local example scheme.</p>
		<div class="cluster" role="group" aria-label="Color scheme simulation controls">
			<button type="button" class="underline" aria-pressed="true" data-save-scheme-class="scheme-default">Inherited</button>
			<button type="button" aria-pressed="false" data-save-scheme-class="light-mode">Light</button>
			<button type="button" aria-pressed="false" data-save-scheme-class="scheme-dark">Dark</button>
		</div>
		</section>
		</div>
	<section class="stack" aria-labelledby="save-status-heading">
		<h2 id="save-status-heading">Proposal text editor simulation</h2>
		<div class="stack stack-compact">
			<label for="proposal-text">Proposal text</label>
			<textarea id="proposal-text" rows="4">A draft paragraph shown for save-status placement.</textarea>
		</div>
		<div class="cluster items-baseline" data-save-editor="proposal">
			<button type="button">Done editing</button>
			@component.SaveStatusComponent(component.SaveStatusProps{ID: "proposal-save-status", State: "ready", SupportingText: "No new save has been confirmed.", Attrs: templ.Attributes{"class": "flex-1", "data-save-region": "proposal"}})
		</div>
		<div data-save-controls hidden>
		<div class="cluster" role="group" aria-label="Proposal save presentation simulations">
			<button type="button" data-save-demo="proposal" data-state="dirty" data-label="Unsaved changes" data-support="Your latest edit has not been confirmed. Simulation only.">Edit</button>
			<button type="button" data-save-demo="proposal" data-state="saving" data-label="Saving…" data-support="The host has started a save. Simulation only.">Saving</button>
			<button type="button" data-save-demo="proposal" data-state="saved" data-label="Draft saved" data-support="The host confirmed this draft. Simulation only.">Confirm save</button>
			<button type="button" data-save-demo="proposal" data-state="saving" data-label="Saving…" data-support="A save is pending. Simulation only.">Start pending save</button>
			<button type="button" data-save-demo="proposal" data-state="dirty" data-label="Unsaved changes" data-support="A save is pending, and newer edits have arrived. Simulation only.">Edit while save is pending</button>
			<button type="button" data-save-demo="proposal" data-state="dirty" data-label="Unsaved changes" data-support="An older completion arrived while newer edits remain unsaved. Simulation only.">Older completion; newer edits remain</button>
			<button type="button" data-save-demo="proposal" data-state="failed" data-label="Couldn’t save draft" data-support="The host rejected this save. Use the separate recovery action. Simulation only.">Failed save</button>
			<button type="button" data-save-demo="proposal" data-state="unknown" data-support="The host cannot confirm the outcome. Simulation only.">Unknown outcome</button>
			<button type="button" data-save-demo="proposal" data-state="saved" data-label="Text saved" data-support="Rules and collaborators still need saving. Simulation only.">Text saved; settings pending</button>
			<button type="button" data-save-demo="proposal" data-state="saved" data-label="Text saved" data-support="The text in this editor has been confirmed, while the longer rules, collaborators and other organization settings remain pending. Simulation only.">Long supporting text</button>
			<button type="button" data-save-demo="proposal" data-state="ready" data-label="Ready" data-support="No new save has been confirmed.">Reset status</button>
		</div>
		</div>
	</section>
	<section class="stack" aria-labelledby="second-save-heading">
		<h2 id="second-save-heading">Second independent editor</h2>
		<div class="stack stack-compact">
			<label for="second-editor-text">Meeting note</label>
			<textarea id="second-editor-text" rows="3">A separate editor with its own status region.</textarea>
		</div>
		<div class="cluster items-baseline" data-save-editor="meeting">
			<button type="button">Done editing</button>
			@component.SaveStatusComponent(component.SaveStatusProps{ID: "meeting-save-status", State: "saving", SupportingText: "Its state is independent of the proposal editor.", Attrs: templ.Attributes{"class": "flex-1", "data-save-region": "meeting"}})
		</div>
		<div data-save-controls hidden>
		<div class="cluster" role="group" aria-label="Meeting note save presentation simulations">
			<button type="button" data-save-demo="meeting" data-state="saved" data-label="Draft saved" data-support="Only this editor is confirmed saved. Simulation only.">Confirm meeting note</button>
			<button type="button" data-save-demo="meeting" data-state="dirty" data-label="Unsaved changes" data-support="Only this editor has unsaved changes. Simulation only.">Edit meeting note</button>
		</div>
		</div>
	</section>
	<section class="stack" aria-labelledby="save-contract-heading">
		<h2 id="save-contract-heading">One status region per editor</h2>
		<p>The host supplies state and scope-aware text. Essential supporting feedback stays in that same atomic region. Publish, retry and Done editing controls stay outside it. These controls change presentation only; they do not save.</p>
	</section>
	</div>
}

templ sortableExample(order []string) {
	@component.SortableListComponent(component.SortableListProps{ID: "demo-sortable", Label: "Review reading order", Variant: "cards"}) {
		<ol data-sortable-list>
			for i, id := range order {
				@component.SortableItemComponent(component.SortableItemProps{ItemID: id, Label: itemNames[id]}) {
					<span data-sortable-content>{ itemNames[id] }</span>
					<span data-sortable-actions>
						@component.SortableHandle(itemNames[id])
						@component.SortableMoveComponent(component.SortableMoveProps{Label: itemNames[id], Direction: "up", Action: "/examples/sortable", Method: "get", ItemID: id, Before: before(order, i, "up"), Disabled: i == 0, Metadata: orderMetadata(order)})
						@component.SortableMoveComponent(component.SortableMoveProps{Label: itemNames[id], Direction: "down", Action: "/examples/sortable", Method: "get", ItemID: id, Before: before(order, i, "down"), Disabled: i == len(order)-1, Metadata: orderMetadata(order)})
					</span>
				}
			}
		</ol>
	}
}

templ orderMetadata(order []string) {
	<input type="hidden" name="order" value={ strings.Join(order, ",") }/>
}

func before(order []string, i int, direction string) string {
	if direction == "up" {
		if i == 0 {
			return order[i]
		}
		return order[i-1]
	}
	if i+2 < len(order) {
		return order[i+2]
	}
	return ""
}

templ inlineExample() {
	<p>Use fictional text. Native submission carries text in the page URL. Enhanced confirmation is a simulation and resets on reload.</p>
	@form.InlineEditCompact(form.InlineEditCompactProps{
		ID: "title-a", ContextID: "gallery-a", Value: "Community gathering", Label: "First title", Name: "title-a", Action: "/examples/inline-edit", Method: "get",
		TriggerLabel: "Edit", EditLabel: "Edit first title", SaveLabel: "Save", CancelLabel: "Cancel", CancelHref: "/examples/inline-edit", CancelLinkLabel: "Reload without saving",
		Class: "stack", RowClass: "cluster cluster-compact items-baseline", FormClass: "cluster cluster-compact", ActionsClass: "cluster cluster-compact",
	})
	@form.InlineEditDisclosure(form.InlineEditDisclosureProps{
		ID: "title-b", ContextID: "gallery-b", Value: "Shared workspace", Label: "Second title", Name: "title-b", Action: "/examples/inline-edit", Method: "get",
		TriggerLabel: "Edit second title", SaveLabel: "Save second title", CancelLabel: "Cancel editing", CancelHref: "/examples/inline-edit", CancelLinkLabel: "Reload without saving",
		Class: "stack", FormClass: "stack", ActionsClass: "cluster",
	})
}
