package main

import "github.com/Design-Machines-Studio/livewires-templ/form"

templ comboboxExample() {
	<p>Timezone override is optional. Leave the empty value selected to use the organization default. This gallery uses public sample choices; applications supply their own options and remote search policy.</p>
	<form id="combobox-form" method="get" action="/examples/combobox" class="stack">
		@form.ComboboxComponent(form.ComboboxProps{
			ID: "local-zone", RootID: "local-choice", Name: "interface_timezone", Label: "Timezone override",
			Placeholder: "Use organization default (UTC)", Options: comboboxTimezoneOptions(),
			Hint: "Search by timezone name or value. Typing does not submit a value.",
			InputAttrs: templ.Attributes{"data-testid": "local-select"},
		})
		<div class="cluster">
			<button class="button" type="submit">Submit choices</button>
			<button class="button button--ghost" type="reset">Reset choices</button>
		</div>
	</form>
	<section class="stack">
		<p>The required control below is associated with the form by its native <code>form</code> attribute. Choose a response mode to simulate application-owned remote results.</p>
		@form.ComboboxRemote(form.ComboboxProps{
			ID: "remote-zone", RootID: "remote-choice", Name: "required_timezone", Label: "Required timezone",
			Placeholder: "Choose a timezone", Options: comboboxTimezoneOptions(), Required: true,
			Form: "combobox-form", Hint: "This field must be selected before the form can submit.",
			InputAttrs: templ.Attributes{"data-testid": "remote-select"},
		})
		<label for="remote-scenario">Remote response mode</label>
		<select id="remote-scenario" aria-describedby="remote-scenario-help">
			<option value="normal">Normal response</option>
			<option value="delayed">Delayed response</option>
			<option value="out-of-order">Out-of-order responses (pa 900 ms, par 100 ms)</option>
			<option value="error">Search error</option>
			<option value="empty">No matches</option>
		</select>
		<p id="remote-scenario-help" class="hint">The remote example filters a local sample list and never calls a service.</p>
	</section>
}
