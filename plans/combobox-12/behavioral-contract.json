{
  "schema_version": 1,
  "contract_id": "combobox-12",
  "revision": 1,
  "previous_contract_digest": null,
  "requirements": [
    {
      "id": "REQ-component",
      "source_ref": "issue-12",
      "statement": "Implement the additive single-select Templ component and accessible form behavior accepted for issue 12."
    },
    {
      "id": "REQ-gallery",
      "source_ref": "issue-12",
      "statement": "Demonstrate local and simulated remote search with native fallback in the maintained gallery."
    },
    {
      "id": "REQ-manual",
      "source_ref": "issue-12",
      "statement": "Report synthetic composition and DOM accessibility separately from real IME and screen-reader checks."
    },
    {
      "id": "REQ-owner",
      "source_ref": "issue-12",
      "statement": "Keep the PR draft and unmerged until final checks and owner UI acceptance pass."
    }
  ],
  "prohibited_regressions": [
    {
      "id": "REG-select",
      "source_ref": "issue-12",
      "statement": "Keep existing Select behavior and required indicator unchanged."
    },
    {
      "id": "REG-native",
      "source_ref": "producer-contract",
      "statement": "Do not submit a second query value or remove native select fallback."
    },
    {
      "id": "REG-assets",
      "source_ref": "issue-12",
      "statement": "Do not copy JavaScript or CSS into the component package."
    }
  ],
  "checks": [
    {
      "id": "CHK-generate",
      "argv": [
        "make",
        "generate"
      ],
      "proves_requirement_ids": [
        "REQ-component"
      ],
      "proves_regression_ids": [
        "REG-assets"
      ],
      "baseline_expectation": "must_pass"
    },
    {
      "id": "CHK-test",
      "argv": [
        "make",
        "test"
      ],
      "proves_requirement_ids": [
        "REQ-component"
      ],
      "proves_regression_ids": [
        "REG-select",
        "REG-native"
      ],
      "baseline_expectation": "must_pass"
    },
    {
      "id": "CHK-vet",
      "argv": [
        "make",
        "lint"
      ],
      "proves_requirement_ids": [
        "REQ-component"
      ],
      "proves_regression_ids": [
        "REG-assets"
      ],
      "baseline_expectation": "must_pass"
    },
    {
      "id": "CHK-gallery",
      "argv": [
        "examples/gallery/run.sh",
        "verify"
      ],
      "proves_requirement_ids": [
        "REQ-gallery"
      ],
      "proves_regression_ids": [
        "REG-native",
        "REG-assets"
      ],
      "baseline_expectation": "must_pass"
    },
    {
      "id": "CHK-browser",
      "argv": [
        "npm",
        "test",
        "--prefix",
        "examples/gallery"
      ],
      "proves_requirement_ids": [
        "REQ-gallery"
      ],
      "proves_regression_ids": [
        "REG-native"
      ],
      "baseline_expectation": "must_pass"
    }
  ],
